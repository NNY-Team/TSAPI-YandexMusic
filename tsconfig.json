{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "resolveJsonModule": true,

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,

    "outDir": "./dist",
    "rootDir": "./src",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,

    "strict": true,
    "skipLibCheck": true,

    "noEmitOnError": false
  },

  "include": ["src", "example-usage.ts", "test-download-track.ts"],
  "exclude": ["node_modules", "dist"]
}
